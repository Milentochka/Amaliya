# Copy this file to .env and fill in real values.
# .env is gitignored — do not commit secrets.

# ---- Backend / FastAPI ----
APP_ENV=development                                # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000                 # public URL for callbacks
APP_FRONTEND_URL=http://localhost:3000             # CORS allow + redirects

# JWT for sessions (guest + admin)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_GUEST_TTL_DAYS=30
JWT_ADMIN_TTL_DAYS=30

# ---- Supabase (DB + Storage) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres

# ---- Telegram Bot (aiogram) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=                             # without @, e.g. amaliya_birthday_bot

# ---- Initial admins (created on first run via CLI) ----
# Two accounts: mom and dad. Logins/passwords are set via a CLI command, not env.
# This is just the bootstrap toggle.
SEED_ADMINS=true

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
